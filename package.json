{
  "name": "react-file-preview-engine",
  "version": "0.1.5",
  "description": "A renderer-driven React file preview engine with extensible architecture for images, video, audio, pdf, html, and custom formats.",
  "license": "MIT",
  "author": "Sahil Aggarwal <aggarwalsahil2004@gmail.com>",
  "contributors": [],
  "homepage": "https://github.com/SahilAggarwal2004/react-file-preview-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SahilAggarwal2004/react-file-preview-engine.git"
  },
  "bugs": {
    "url": "https://github.com/SahilAggarwal2004/react-file-preview-engine/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm i && pnpm run compile",
    "compile": "tsup",
    "dev": "tsup --watch",
    "dry-release": "release-it --ci --dry-run",
    "release": "release-it --ci"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/index.d.ts",
  "dependencies": {
    "mime": "^4.1.0",
    "react-file-icon": "^1.6.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/react": "^19.2.7",
    "@types/react-file-icon": "^1.0.4",
    "release-it": "^19.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "arraybuffer",
    "audio-preview",
    "blob",
    "component",
    "custom-renderer",
    "document-viewer",
    "extensible",
    "file",
    "file-preview",
    "file-viewer",
    "image-preview",
    "mime-type",
    "pdf-viewer",
    "preview",
    "react",
    "react-file-preview-engine",
    "renderer",
    "typescript",
    "video-preview",
    "viewer"
  ]
}
