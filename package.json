{
  "name": "react-file-preview-engine",
  "version": "1.1.0",
  "description": "A renderer-driven React file preview engine with extensible architecture for images, video, audio, pdf, html, and custom formats.",
  "license": "MIT",
  "author": "Sahil Aggarwal <aggarwalsahil2004@gmail.com>",
  "contributors": [],
  "homepage": "https://github.com/SahilAggarwal2004/react-file-preview-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SahilAggarwal2004/react-file-preview-engine.git"
  },
  "bugs": {
    "url": "https://github.com/SahilAggarwal2004/react-file-preview-engine/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./style.css": "./dist/style.css",
    "./types": "./dist/types.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm i && pnpm run compile",
    "compile": "tsdown",
    "dev": "tsdown --watch",
    "dry-release": "release-it --ci --dry-run",
    "prettier": "prettier-package-json --write package.json",
    "pub": "pnpm login && pnpm publish",
    "release": "release-it --ci"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.mts",
  "dependencies": {
    "mime": "^4.1.0",
    "react-file-icon": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tsdown/css": "^0.21.7",
    "@types/react": "^19.2.14",
    "@types/react-file-icon": "^1.0.5",
    "prettier-package-json": "^2.8.0",
    "release-it": "^19.2.4",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "arraybuffer",
    "audio-preview",
    "blob",
    "component",
    "custom-renderer",
    "document-viewer",
    "extensible",
    "file",
    "file-preview",
    "file-viewer",
    "image-preview",
    "mime-type",
    "pdf-viewer",
    "preview",
    "react",
    "react-file-preview-engine",
    "renderer",
    "typescript",
    "video-preview",
    "viewer"
  ]
}
